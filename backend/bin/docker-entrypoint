#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare

  # db:seed truncates employees, so only run it on an empty DB
  if [ "$(./bin/rails runner 'puts Employee.count')" == "0" ]; then
    ./bin/rails db:seed
  fi
fi

exec "${@}"
